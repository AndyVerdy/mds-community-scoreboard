# Secrets — never commit
.intercom_token
.airtable_pat
.env
.env.local
.env.*
*.token
*.pat

# Import artifacts
tmp/
.olivia_wf.lock
olivia_snapshots/*
!olivia_snapshots/_targets.json

# Machine noise — never carries information (2026-08-11)
.DS_Store
__pycache__/
*.pyc

# ROTATING job logs: launchd appends on every run, so a tracked copy makes the
# working tree permanently dirty and `git status` stops meaning anything.
# NOTE: this is deliberately NOT `*.log` — one-time records are EVIDENCE and stay
# tracked: scripts/typeform_prune.log (the #78 deletion),
# scripts/event_roster_writeback_applied.log (applied-changes ledger),
# smoke_prod_*.log (release artifacts).
scripts/alarm_watchdog.log
scripts/db_drift.log
scripts/nightly_derivations.log
scripts/zoom_weekly.log
eval_run*.log

# Eval reports: the DATED file per day stays tracked (quality history #76 mines).
# The last timestamped run of a day is written twice under both names — byte-identical,
# verified 2026-08-11 — so ignore that twin only. Earlier same-day runs are DISTINCT
# runs and remain tracked.
OLIVIA_EVAL_*_[0-9][0-9][0-9][0-9].md
!OLIVIA_EVAL_LIST_*.md

# Bulk working artifacts, reproducible or backed up elsewhere
scripts/make_backups/
scripts/.partners_delta_dump.json
