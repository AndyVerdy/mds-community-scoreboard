{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__n8n-mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/Born/Scorecard/.claude/hooks/olivia_wf_lock.py",
            "timeout": 10,
            "statusMessage": "Checking the Olivia workflow editing lock"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/Born/Scorecard/.claude/hooks/session-start.sh",
            "timeout": 15,
            "statusMessage": "Loading Olivia handoff + drift-check reminder"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/Born/Scorecard/.claude/hooks/stop-handoff.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
